    }, {
      "name": "HK_DUMP", "title": "Dump the holykeebs settings to the console (debug firmware only)", "shortName": "HK\nDump"
    }, {
      "name": "HK_P_SET_D", "title": "Hold, then tap up/down to change the pointer sensitivity", "shortName": "Sens\nSet"
    }, {
      "name": "HK_P_SET_S", "title": "Hold, then tap up/down to change the sniping sensitivity", "shortName": "Snipe\nSens"
    }, {
      "name": "HK_P_SET_THR", "title": "Hold, then tap up/down to change the ball's scroll throttle", "shortName": "Scrl\nThr"
